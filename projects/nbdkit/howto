$ mkdir -p /var/appjail-volumes/nbdkit
$ truncate -s 20G /var/appjail-volumes/nbdkit/data.img
$ appjail oci run -Pd \
    -e PUID=$(id -u) \
    -e PGID=$(id -g) \
    -o overwrite=force \
    -o virtualnet=":<random> default" \
    -o nat \
    -o fstab="/var/appjail-volumes/nbdkit/data.img /disk" \
    ghcr.io/appjail-makejails/nbdkit some-nbdkit \
    -t $(nproc) -f file file=/disk fadvise=sequential
$ # See https://www.freshports.org/filesystems/nbd-client-kmod/
$ gnbd connect some-nbdkit
